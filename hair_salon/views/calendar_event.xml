<odoo>
    <record id="view_calendar_event_form_inherit_hair" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.hair</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <!-- Solo se muestra en eventos generados por una reserva -->
                <header invisible="not booking_state">
                    <field name="booking_state"
                           widget="statusbar"
                           statusbar_visible="pending,scheduled,confirmed,arrived,in_progress,completed"/>

                    <button name="action_calendar_arrive"
                            string="Llegó"
                            type="object"
                            class="oe_highlight"
                            groups="hair_salon.group_hair_receptionist"
                            invisible="booking_state not in ('scheduled', 'confirmed')"/>

                    <button name="action_calendar_start"
                            string="Iniciar Atención"
                            type="object"
                            class="oe_highlight"
                            groups="hair_salon.group_hair_stylist"
                            invisible="booking_state not in ('scheduled', 'confirmed', 'arrived')"/>

                    <button name="action_calendar_complete"
                            string="Finalizar Atención"
                            type="object"
                            class="oe_highlight"
                            groups="hair_salon.group_hair_stylist"
                            invisible="booking_state != 'in_progress'"/>

                    <button name="action_calendar_no_show"
                            string="No asistió"
                            type="object"
                            confirm="¿Marcar que el cliente no asistió a la cita?"
                            groups="hair_salon.group_hair_receptionist"
                            invisible="booking_state not in ('scheduled', 'confirmed')"/>
                </header>
            </xpath>

        </field>
    </record>
</odoo>
