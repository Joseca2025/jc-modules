<odoo>
    <record id="view_resource_booking_form_inherit_hair_states" model="ir.ui.view">
        <field name="name">resource.booking.form.inherit.hair.states</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">pending,scheduled,confirmed,arrived,in_progress,completed</attribute>
            </xpath>

            <!-- Desagendar y Cancelar ya se ocultan solos: is_modifiable es False en una atención iniciada -->
            <xpath expr="//header" position="inside">
                <button name="action_arrive"
                        string="Llegó"
                        type="object"
                        class="oe_highlight"
                        groups="hair_salon.group_hair_receptionist"
                        invisible="state not in ('scheduled', 'confirmed')"/>

                <button name="action_progress"
                        string="Iniciar Atención"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('scheduled', 'confirmed', 'arrived')"/>

                <button name="action_complete"
                        string="Finalizar Atención"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'in_progress'"/>

                <button name="action_no_show"
                        string="No asistió"
                        type="object"
                        confirm="¿Marcar que el cliente no asistió a la cita?"
                        groups="hair_salon.group_hair_receptionist"
                        invisible="state not in ('scheduled', 'confirmed')"/>

                <button name="action_reopen"
                        string="Reabrir"
                        type="object"
                        confirm="La reserva vuelve a la agenda y se borran las horas reales registradas. ¿Continuar?"
                        groups="hair_salon.group_hair_manager"
                        invisible="state not in ('arrived', 'in_progress', 'completed', 'no_show')"/>
            </xpath>

            <xpath expr="//group[@name='meeting']" position="inside">
                <field name="arrival_datetime" invisible="not arrival_datetime"/>
                <field name="service_start_datetime" invisible="not service_start_datetime"/>
                <field name="service_end_datetime" invisible="not service_end_datetime"/>
                <field name="canceled_start" invisible="not canceled_start"/>
                <field name="canceled_datetime" invisible="not canceled_datetime"/>
            </xpath>
        </field>
    </record>
</odoo>
