<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hair_salon" model="ir.module.category">
        <field name="name">Hair Salon</field>
    </record>

    <record id="group_hair_stylist" model="res.groups">
        <field name="name">Estilista</field>
        <field name="category_id" ref="module_category_hair_salon"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('resource_booking.group_user'))]"/>
        <field name="comment">Ve y atiende sus propias citas.</field>
    </record>

    <record id="group_hair_receptionist" model="res.groups">
        <field name="name">Recepción</field>
        <field name="category_id" ref="module_category_hair_salon"/>
        <field name="implied_ids" eval="[(4, ref('group_hair_stylist'))]"/>
        <field name="comment">Ve la agenda completa y reprograma citas sin límite de plazo.</field>
    </record>

    <record id="group_hair_manager" model="res.groups">
        <field name="name">Encargado</field>
        <field name="category_id" ref="module_category_hair_salon"/>
        <field name="implied_ids" eval="[(4, ref('group_hair_receptionist')), (4, ref('resource_booking.group_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configura el salón y reabre atenciones.</field>
    </record>

    <data noupdate="1">
        <record id="rule_hair_appointment_company" model="ir.rule">
            <field name="name">Citas: multiempresa</field>
            <field name="model_id" ref="model_hair_appointment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('booking_id.type_id.company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_hair_appointment_stylist" model="ir.rule">
            <field name="name">Citas: el estilista ve las suyas</field>
            <field name="model_id" ref="model_hair_appointment"/>
            <field name="groups" eval="[(4, ref('group_hair_stylist'))]"/>
            <field name="domain_force">[('booking_id.combination_id.resource_ids.user_id', 'in', [user.id])]</field>
        </record>

        <record id="rule_hair_appointment_receptionist" model="ir.rule">
            <field name="name">Citas: recepción ve todas</field>
            <field name="model_id" ref="model_hair_appointment"/>
            <field name="groups" eval="[(4, ref('group_hair_receptionist'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_resource_booking_receptionist" model="ir.rule">
            <field name="name">Reservas: recepción ve todas</field>
            <field name="model_id" ref="resource_booking.model_resource_booking"/>
            <field name="groups" eval="[(4, ref('group_hair_receptionist'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
