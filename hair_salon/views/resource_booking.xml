<odoo>
    <record id="view_resource_booking_form_inherit_hair_states" model="ir.ui.view">
        <field name="name">resource.booking.form.inherit.hair.states</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form"/>
        <field name="arch" type="xml">

            <!-- 1. Actualizamos la barra de estados para incluir los nuevos en orden -->
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state"
                       widget="statusbar"
                       statusbar_visible="pending,scheduled,confirmed,in_progress,completed,canceled"/>
            </xpath>

            <!-- 2. Agregamos los botones en el header para interactuar con los estados -->
            <xpath expr="//header" position="inside">
                <button name="action_progress"
                        string="Iniciar Atención"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'confirmed'"/>

                <button name="action_complete"
                        string="Finalizar Atención"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'in_progress'"/>
            </xpath>
            <xpath expr="//button[@name='action_unschedule']" position="attributes">
                <attribute name="invisible">not is_modifiable or not meeting_id or state in ('in_progress', 'completed')</attribute>
            </xpath>

            <!-- Cancelar (sin reunión) -->
            <xpath expr="(//button[@name='action_cancel'])[1]" position="attributes">
                <attribute name="invisible">not is_modifiable or state in ('canceled', 'completed') or meeting_id
                </attribute>
            </xpath>

            <!-- Cancelar (con reunión) -->
            <xpath expr="(//button[@name='action_cancel'])[2]" position="attributes">
                <attribute name="invisible">not is_modifiable or state in ('canceled', 'completed') or not meeting_id
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>